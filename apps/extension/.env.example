# Copy to .env.staging or .env.production (or set these in CI) before
# `npm run build:staging` / `npm run build:prod`. Both are required; staging
# and production builds also require https.

# Backend API base, including the /api/v1 prefix.
VITE_API_URL=https://api.example.com/api/v1

# Web dashboard origin. Also becomes the only origin allowed to message the
# extension (manifest externally_connectable).
VITE_DASHBOARD_URL=https://app.example.com
