{
  "type": "module",
  "name": "context-workspace",
  "private": true,
  "version": "3.0.0",
  "description": "Connecting Dots — keeps your AI conversations searchable, as a Chrome extension",
  "scripts": {
    "dev": "vite build --config vite.popup.config.ts --watch --mode development",
    "build": "node scripts/build.mjs --mode development",
    "build:staging": "node scripts/build.mjs --mode staging",
    "build:prod": "node scripts/build.mjs --mode production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
