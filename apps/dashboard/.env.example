# Copy to .env.local (local) or set in your host's environment (deployed).

# Backend API base, including the /api/v1 prefix. Required.
#   Local development: the API itself, e.g. http://localhost:8000/api/v1
#   Deployed: /api/v1, so the browser calls this dashboard, which forwards
#   to API_UPSTREAM_URL (src/proxy.ts). That keeps the sign-in cookie
#   same-site; across sites it isn't sent and every reload signs you out.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Server-only. Where /api/* is forwarded, without a path, e.g.
# https://connecting-dots-api-xxxx.run.app. Unset: nothing is forwarded.
API_UPSTREAM_URL=

# Server-only. The API's PROXY_SHARED_SECRET (same value), so the API trusts
# the visitor address this proxy reports for its per-IP limits. Only used
# on Vercel, which supplies that address.
PROXY_SHARED_SECRET=

# Chrome extension ID, from chrome://extensions after loading
# apps/extension/dist unpacked. Optional: without it the dashboard can't ask
# the extension to open AI sessions when a project is created.
NEXT_PUBLIC_EXTENSION_ID=

# Contact address for privacy questions, account deletion requests and
# feedback, shown on /privacy, /terms and /feedback. Required before launch:
# until it's set those pages say no address is configured.
NEXT_PUBLIC_CONTACT_EMAIL=
