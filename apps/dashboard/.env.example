# Copy to .env.local (local) or set in your host's environment (deployed).

# Backend API base, including the /api/v1 prefix. Required.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Chrome extension ID, from chrome://extensions after loading
# apps/extension/dist unpacked. Optional: without it the dashboard can't ask
# the extension to open AI sessions when a project is created.
NEXT_PUBLIC_EXTENSION_ID=
