# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME="AI Context Workspace"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=true

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# The extension's origin, chrome-extension://<id> (see chrome://extensions).
# Unset: development accepts any extension, other environments accept none.
EXTENSION_ORIGIN=

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_context_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Or a hosted database: DATABASE_URL wins over the POSTGRES_* values above.
# Paste the libpq URL as given (e.g. Neon's ...?sslmode=require&channel_binding=require);
# the API adapts it for asyncpg and turns off statement caching behind Neon's
# pooler. DATABASE_URL_UNPOOLED (the direct URL) is used for migrations.
# `neon deploy` writes both to .env.local, which the API also reads.
# Tests never use these: they always run against a local "<POSTGRES_DB>_test".
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# ─────────────────────────────────────────────
# Redis (future-ready — not active yet)
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | console

# ─────────────────────────────────────────────
# Auth (JWT access/refresh tokens)
#
# SECURITY: this file is a template — never put a real secret in .env.example.
# JWT_SECRET_KEY has NO default in Settings — the app refuses to start
# without a real value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotate immediately (and expect all existing sessions to be invalidated) if
# this value is ever committed or leaked.
# ─────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────────
# Auth: bootstrapped admin user
#
# Used ONLY by the 0007 migration to create one admin user and assign any
# projects created before auth existed to them. Change ADMIN_PASSWORD after
# first login in any real deployment.
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ─────────────────────────────────────────────
# OpenAI — cloud LLM for RAG answer generation (Ask AI)
#
# SECURITY: this file is a template — never put a real key in .env.example.
# Put your real key only in .env (already gitignored) or your deployment's
# secret manager / environment variables. If a key is ever committed or
# leaked, rotate it immediately from the OpenAI dashboard.
#
# If OPENAI_API_KEY is unset, Ask AI degrades gracefully: it returns the top
# matching excerpt instead of a generated answer rather than failing the
# request.
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=512
OPENAI_TIMEOUT_SEC=30
OPENAI_CONTEXT_CHUNKS=3

# ─────────────────────────────────────────────
# Email (Resend) — verification and password-reset links
#
# SECURITY: never put a real key in .env.example; only in .env (gitignored)
# or your host's secrets. Without a key, development writes each email to
# the API log instead of sending it; other environments send nothing.
#
# EMAIL_FROM: onboarding@resend.dev works with no setup but only delivers to
# your own Resend account's address. To email anyone, verify a domain in
# Resend (Domains) and use an address on it.
# DASHBOARD_URL: where the links in emails point (your dashboard's origin).
# ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Connecting Dots <onboarding@resend.dev>
DASHBOARD_URL=http://localhost:3000
EMAIL_VERIFY_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=60
