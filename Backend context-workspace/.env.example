# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME="AI Context Workspace"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=true

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_context_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Constructed by settings (do not set manually unless overriding)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_context_workspace

# ─────────────────────────────────────────────
# Redis (future-ready — not active yet)
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | console

# ─────────────────────────────────────────────
# Future: Auth (placeholder)
# ─────────────────────────────────────────────
# SECRET_KEY=changeme
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────
# OpenAI — cloud LLM for RAG answer generation (Ask AI)
#
# SECURITY: this file is a template — never put a real key in .env.example.
# Put your real key only in .env (already gitignored) or your deployment's
# secret manager / environment variables. If a key is ever committed or
# leaked, rotate it immediately from the OpenAI dashboard.
#
# If OPENAI_API_KEY is unset, Ask AI degrades gracefully: it returns the top
# matching excerpt instead of a generated answer rather than failing the
# request.
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=512
OPENAI_TIMEOUT_SEC=30
OPENAI_CONTEXT_CHUNKS=3
